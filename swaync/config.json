{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 380,
  "widgets": [
    "label",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "label": {
      "max-lines": 1,
      "text": "Control Center"
    },
    "mpris": {
      "image-size": 80,
      "image-radius": 12
    },
    "volume": {
      "label": "\uF028"
    },
    "backlight": {
      "label": "\uF185",
      "device": "intel_backlight",
      "subsystem": "backlight"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "buttons-grid": {
        "actions": [
        {
          "label": "\uF1EB  Wi-Fi",
          "command": "nm-connection-editor"
        },
        {
          "label": "\uF293  Bluetooth",
          "command": "blueman-manager"
        },
        {
          "label": "\uF021  Reboot",
          "command": "swaync-client -cp && python3 ~/.config/hypr/scripts/hold_power.py reboot"
        },
        {
          "label": "\uF011  Power",
          "command": "swaync-client -cp && python3 ~/.config/hypr/scripts/hold_power.py power"
        }
      ]
    }
  }
}
